  "components": {
    "schemas": {
      "CategoryCreate": {
        "additionalProperties": false,
        "description": "Body of `POST /api/category`.",
        "properties": {
          "name": {
            "description": "category name",
            "maxLength": 50,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 20000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "category description",
            "title": "Description"
          }
        },
        "required": [
          "name"
        ],
        "title": "CategoryCreate",
        "type": "object"
      },
      "CategoryListOut": {
        "description": "Body of `GET /api/category`. A wrapping object, so fields can be added later.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CategoryOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "CategoryListOut",
        "type": "object"
      },
      "CategoryOut": {
        "description": "A category as returned by the API.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "CategoryOut",
        "type": "object"
      },
      "CommentCreate": {
        "additionalProperties": false,
        "description": "Body of `POST /api/feedback/{id}/comments`.\n\nWhitespace is stripped first, so a blank comment fails `min_length`.",
        "properties": {
          "comment": {
            "description": "Comment provided by the user to the feedback",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Comment",
            "type": "string"
          }
        },
        "required": [
          "comment"
        ],
        "title": "CommentCreate",
        "type": "object"
      },
      "CommentListOut": {
        "description": "Body of `GET /api/feedback/{id}/comments`, best score first.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CommentWithScoreOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "CommentListOut",
        "type": "object"
      },
      "CommentOut": {
        "description": "A comment as returned by the API.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "feedback_id": {
            "title": "Feedback Id",
            "type": "integer"
          },
          "comment": {
            "title": "Comment",
            "type": "string"
          }
        },
        "required": [
          "id",
          "feedback_id",
          "comment"
        ],
        "title": "CommentOut",
        "type": "object"
      },
      "CommentWithScoreOut": {
        "description": "A comment in a list, with its vote totals.\n\n`score` is the sum of its notations (0 when it has none); `votes` is how\nmany notations it received.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "feedback_id": {
            "title": "Feedback Id",
            "type": "integer"
          },
          "comment": {
            "title": "Comment",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          },
          "votes": {
            "title": "Votes",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "feedback_id",
          "comment",
          "score",
          "votes"
        ],
        "title": "CommentWithScoreOut",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "What went wrong: the status code and a human-readable message.",
        "properties": {
          "code": {
            "description": "HTTP status code",
            "examples": [
              422
            ],
            "title": "Code",
            "type": "integer"
          },
          "message": {
            "description": "What went wrong; for 422, one 'field: problem' per invalid field",
            "examples": [
              "rating: Input should be 1, 2, 3, 4 or 5"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorOut": {
        "description": "`{\"error\": {\"code\": ..., \"message\": ...}}`, written by BaseHandler.write_error.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
