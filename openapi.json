      "get": {
        "summary": "List all categories",
        "tags": [
          "categories"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListOut"
                }
              }
            }
          }
