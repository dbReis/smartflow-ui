            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "feedback_id",
            "in": "path",
            "required": true,
            "description": "The feedback to update",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999
            }
          }
        ],
        "security": [
          {
            "pmKey": []
          }
        ]
      }
    },
