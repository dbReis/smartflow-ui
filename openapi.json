{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartFlow API",
    "version": "0.1.0",
    "description": "Async REST API for rated user feedback."
  },
  "tags": [
    {
      "name": "feedback",
      "description": "Browse and post feedback"
    },
    {
      "name": "comments",
      "description": "Read and post the discussion of a feedback"
    },
    {
      "name": "notations",
      "description": "Rate comments (-1, 0, +1)"
    },
    {
      "name": "categories",
      "description": "Categories feedback can be put in"
    },
    {
      "name": "Product Manager",
      "description": "Triage feedback. Requires the PM key: click Authorize."
    },
    {
      "name": "health",
      "description": "Service status"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check that the server is up",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "The server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "get": {
        "summary": "List active feedback, newest first, with comment counts",
        "tags": [
          "feedback"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackListOut"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post a feedback",
        "tags": [
          "feedback"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of the created resource",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Valid JSON, but invalid or unknown fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback/{feedback_id}": {
      "get": {
        "summary": "Get one feedback (merged ones too: see merged_into_id)",
        "tags": [
          "feedback"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            }
          },
          "404": {
            "description": "A referenced resource does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "feedback_id",
            "in": "path",
            "required": true,
            "description": "The feedback to read",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999
            }
          }
        ]
      }
    },
    "/api/feedback/{feedback_id}/comments": {
      "get": {
        "summary": "List the comments of a feedback, best score first",
        "tags": [
          "comments"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentListOut"
                }
              }
            }
          },
          "404": {
            "description": "A referenced resource does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "feedback_id",
            "in": "path",
            "required": true,
            "description": "The feedback whose comments to list",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999
            }
          }
        ]
      },
      "post": {
        "summary": "Comment on a feedback",
        "tags": [
          "comments"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentOut"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of the created resource",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "A referenced resource does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "The feedback was merged into another one and is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Valid JSON, but invalid or unknown fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "feedback_id",
            "in": "path",
            "required": true,
            "description": "The feedback to comment on",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999
            }
          }
        ]
      }
    },
    "/api/comments/{comment_id}/notation": {
      "put": {
        "summary": "Give or change your notation (-1, 0 or +1) on a comment",
        "tags": [
          "notations"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotationCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotationOut"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "A referenced resource does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Valid JSON, but invalid or unknown fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-User-Id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "comment_id",
            "in": "path",
            "required": true,
            "description": "The comment to rate",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "description": "Identifies the user (e.g. a UUID the client keeps)",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ]
      }
    },
    "/api/feedback/{feedback_id}/status": {
      "put": {
        "summary": "Set the status of a feedback",
        "tags": [
